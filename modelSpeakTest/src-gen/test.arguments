  <argumentElements xsi:type="arguments:ModelAssumption" id="49" assumption="a2" assumptionText="not explicitly consider the presence of FZ for LRP6 receptor internalization in the context of canonical WNT signaling"/>
  <argumentElements xsi:type="arguments:ModelAssumption" id="50" assumption="a3" assumptionText="the impact of FZ on LRP6 internalization dynamics can be neglected, as both receptors are activated through WNT3a and internalized in a similar way and with similar dynamic"/>
  <argumentElements xsi:type="arguments:ExperimentResults" id="51" experimentName="s1" results="Simulation experiment in SESSL: parameter scans of ke and comparison of time courses of LRP6 at membrane and in endosome to in vitro measurements. Both for CME and CIE, results show significant deviations of the mean+/-s.e.m."/>
